{
  "$schema": "https://schema.railpack.com",
  "caches": {
    "pub": {
      "directory": "/root/.pub-cache",
      "type": "shared"
    },
    "mise": {
      "directory": "/root/.local/share/mise",
      "type": "shared"
    }
  },
  "steps": {
    "setup": {
      "inputs": [
        { "image": "ubuntu:24.04" },
        { "local": true, "include": ["."] }
      ],
      "commands": [
        { "cmd": "apt-get update && apt-get install -y curl git libsqlite3-dev", "customName": "Install system dependencies" },
        { "cmd": "curl https://mise.run | sh", "customName": "Install mise" },
        { "path": "/root/.local/bin" },
        { "cmd": "mise use -g dart@3.10", "customName": "Install Dart 3.10 via mise" },
        { "path": "/root/.local/share/mise/shims" }
      ],
      "caches": ["mise"]
    },
    "build": {
      "inputs": [
        { "step": "setup" },
        { "local": true, "include": ["."] }
      ],
      "caches": ["pub"],
      "commands": [
        { "cmd": "dart pub get", "customName": "Install dependencies" },
        {
          "cmd": "dart compile exe bin/server.dart -o bin/server",
          "customName": "Compile server binary"
        }
      ],
      "deployOutputs": [{ "include": ["bin/server"] }]
    }
  },
  "deploy": {
    "aptPackages": ["libsqlite3-0"],
    "startCommand": "./bin/server"
  }
}
